# General-purpose aliases — work on any platform

alias c='clear'
alias now='date +"%F %T %Z"'
alias path='echo -e ${PATH//:/\\n}'
alias hgrep='history | grep'
alias sizeof='du -chs'
alias space='df -h'
alias cmount='mount | column -t'
alias emptydirs='find . -type d -empty'
alias findfile='find . -type f -name'
alias reboot='shutdown -r'
alias dotfile='stow -vt ~'
alias tldr='tldr -t base16'

# Open files/URLs with the OS default handler.
# macOS ships its own `open`; elsewhere fall back to xdg-open (silenced/detached).
open() {
  case "$OSTYPE" in
    darwin*) command open "$@" ;;
    *)
      if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$@" >/dev/null 2>&1
      else
        command open "$@"
      fi
      ;;
  esac
}
